<!-- AST&#45;100 -->
<g id="node11" class="node">
<title>AST&#45;100</title>
<polygon fill="none" stroke="black" points="1051,-341.5 772,-341.5 772,-258.5 1051,-258.5 1051,-341.5"/>
<text text-anchor="middle" x="911.5" y="-326.3" font-family="Open Sans" font-size="14.00">AST&#45;100: If the CAN bus is disconnected</text>
<text text-anchor="middle" x="911.5" y="-311.3" font-family="Open Sans" font-size="14.00">or the RPi stops transmitting, the</text>
<text text-anchor="middle" x="911.5" y="-296.3" font-family="Open Sans" font-size="14.00">PWM output pins of the STM32 should</text>
<text text-anchor="middle" x="911.5" y="-281.3" font-family="Open Sans" font-size="14.00">be brought to 0% within a time interval</text>
<text text-anchor="middle" x="911.5" y="-266.3" font-family="Open Sans" font-size="14.00">such that t &lt; 110ms. </text>
</g>
