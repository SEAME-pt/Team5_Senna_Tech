<polygon fill="black" stroke="black" points="384.34,-343.93 388.05,-334 378.96,-339.45 384.34,-343.93"/>
</g>
<!-- EXP&#45;600 -->
<g id="node106" class="node">
<title>EXP&#45;600</title>
<polygon fill="none" stroke="black" points="8036,-505.5 7753,-505.5 7753,-437.5 8036,-437.5 8036,-505.5"/>
<text text-anchor="middle" x="7894.5" y="-490.3" font-family="Open Sans" font-size="14.00">EXP&#45;600: The system must automatically</text>
<text text-anchor="middle" x="7894.5" y="-475.3" font-family="Open Sans" font-size="14.00">launch all applications necessary</text>
<text text-anchor="middle" x="7894.5" y="-460.3" font-family="Open Sans" font-size="14.00">for the project to function properly</text>
<text text-anchor="middle" x="7894.5" y="-445.3" font-family="Open Sans" font-size="14.00">during boot. </text>
</g>
<!-- EXP&#45;600&#45;&gt;AST&#45;600 -->
