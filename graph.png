<polygon fill="black" stroke="black" points="3111,-351.53 3107.5,-341.53 3104,-351.53 3111,-351.53"/>
</g>
<!-- EXP&#45;207 -->
<g id="node96" class="node">
<title>EXP&#45;207</title>
<polygon fill="none" stroke="black" points="2666,-505.5 2373,-505.5 2373,-437.5 2666,-437.5 2666,-505.5"/>
<text text-anchor="middle" x="2519.5" y="-490.3" font-family="Open Sans" font-size="14.00">EXP&#45;207: The system shall cross&#45;reference</text>
<text text-anchor="middle" x="2519.5" y="-475.3" font-family="Open Sans" font-size="14.00">speedometer data with a secondary</text>
<text text-anchor="middle" x="2519.5" y="-460.3" font-family="Open Sans" font-size="14.00">speed estimate (such as IMU derivative)</text>
<text text-anchor="middle" x="2519.5" y="-445.3" font-family="Open Sans" font-size="14.00">to identify inconsistencies. </text>
</g>
<!-- EXP&#45;207&#45;&gt;AST&#45;207 -->
<g id="edge71" class="edge">
<title>EXP&#45;207&#45;&gt;AST&#45;207</title>
