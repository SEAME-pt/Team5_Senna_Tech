<!-- ASM&#45;101 -->
<g id="node3" class="node">
<title>ASM&#45;101</title>
<polygon fill="none" stroke="black" points="1581,-185 1310,-185 1310,-87 1581,-87 1581,-185"/>
<text text-anchor="middle" x="1445.5" y="-169.8" font-family="Open Sans" font-size="14.00">ASM&#45;101: It is assumed that the CAN</text>
<text text-anchor="middle" x="1445.5" y="-154.8" font-family="Open Sans" font-size="14.00">network is physically terminated</text>
<text text-anchor="middle" x="1445.5" y="-139.8" font-family="Open Sans" font-size="14.00">with 1200Ω resistors at both ends,</text>
<text text-anchor="middle" x="1445.5" y="-124.8" font-family="Open Sans" font-size="14.00">minimizing signal reflections that</text>
<text text-anchor="middle" x="1445.5" y="-109.8" font-family="Open Sans" font-size="14.00">could cause errors at high frequencies</text>
<text text-anchor="middle" x="1445.5" y="-94.8" font-family="Open Sans" font-size="14.00">such as 500kbps. </text>
</g>
