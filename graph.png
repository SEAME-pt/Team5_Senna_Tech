<!-- AST&#45;104 -->
<g id="node15" class="node">
<title>AST&#45;104</title>
<polygon fill="none" stroke="black" points="4909.5,-200 4633.5,-200 4633.5,-72 4909.5,-72 4909.5,-200"/>
<text text-anchor="middle" x="4771.5" y="-184.8" font-family="Open Sans" font-size="14.00">AST&#45;104: The nominal interval between</text>
<text text-anchor="middle" x="4771.5" y="-169.8" font-family="Open Sans" font-size="14.00">control messages should be 2 ms.</text>
<text text-anchor="middle" x="4771.5" y="-154.8" font-family="Open Sans" font-size="14.00">The assertion is true if the measured</text>
<text text-anchor="middle" x="4771.5" y="-139.8" font-family="Open Sans" font-size="14.00">interval T is within the range 1.8</text>
<text text-anchor="middle" x="4771.5" y="-124.8" font-family="Open Sans" font-size="14.00">ms &lt;= T &gt;= 2.2 ms. Furthermore, there</text>
<text text-anchor="middle" x="4771.5" y="-109.8" font-family="Open Sans" font-size="14.00">should be no loss of more than 2</text>
<text text-anchor="middle" x="4771.5" y="-94.8" font-family="Open Sans" font-size="14.00">consecutive frames in a 1&#45;second</text>
<text text-anchor="middle" x="4771.5" y="-79.8" font-family="Open Sans" font-size="14.00">period. </text>
</g>
<!-- AST&#45;104&#45;&gt;EVD&#45;104 -->
<g id="edge16" class="edge">
<title>AST&#45;104&#45;&gt;EVD&#45;104</title>
<path fill="none" stroke="black" d="M4854.17,-71.91C4867.93,-61.41 4881.4,-51.13 4892.75,-42.47"/>
<polygon fill="black" stroke="black" points="4895.16,-45.03 4900.98,-36.18 4890.91,-39.47 4895.16,-45.03"/>
</g>
<!-- AST&#45;105 -->
<g id="node16" class="node">
<title>AST&#45;105</title>
<polygon fill="none" stroke="black" points="6534,-349 6231,-349 6231,-251 6534,-251 6534,-349"/>
<text text-anchor="middle" x="6382.5" y="-333.8" font-family="Open Sans" font-size="14.00">AST&#45;105: During a 5&#45;minute test,</text>
<text text-anchor="middle" x="6382.5" y="-318.8" font-family="Open Sans" font-size="14.00">100% of the frames transmitted by</text>
<text text-anchor="middle" x="6382.5" y="-303.8" font-family="Open Sans" font-size="14.00">the RPi for control must use the</text>
<text text-anchor="middle" x="6382.5" y="-288.8" font-family="Open Sans" font-size="14.00">CAN IDs predefined in the protocol</text>
<text text-anchor="middle" x="6382.5" y="-273.8" font-family="Open Sans" font-size="14.00">specification document (e.g., Speed=0x100,</text>
<text text-anchor="middle" x="6382.5" y="-258.8" font-family="Open Sans" font-size="14.00">Steer=0x101). </text>
</g>
