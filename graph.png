</g>
<!-- EXP&#45;601 -->
<g id="node107" class="node">
<title>EXP&#45;601</title>
<polygon fill="none" stroke="black" points="8623,-513 8342,-513 8342,-430 8623,-430 8623,-513"/>
<text text-anchor="middle" x="8482.5" y="-497.8" font-family="Open Sans" font-size="14.00">EXP&#45;601: The system (AGL on Raspberry</text>
<text text-anchor="middle" x="8482.5" y="-482.8" font-family="Open Sans" font-size="14.00">Pi) has conditions to store all the</text>
<text text-anchor="middle" x="8482.5" y="-467.8" font-family="Open Sans" font-size="14.00">data necessary for its operation</text>
<text text-anchor="middle" x="8482.5" y="-452.8" font-family="Open Sans" font-size="14.00">without risk of failure due to lack</text>
<text text-anchor="middle" x="8482.5" y="-437.8" font-family="Open Sans" font-size="14.00">of space. </text>
</g>
