<!-- EXP&#45;502 -->
<g id="node105" class="node">
<title>EXP&#45;502</title>
<polygon fill="none" stroke="black" points="428.5,-505.5 120.5,-505.5 120.5,-437.5 428.5,-437.5 428.5,-505.5"/>
<text text-anchor="middle" x="274.5" y="-490.3" font-family="Open Sans" font-size="14.00">EXP&#45;502: The instrument cluster shall</text>
<text text-anchor="middle" x="274.5" y="-475.3" font-family="Open Sans" font-size="14.00">present warning and status indications</text>
<text text-anchor="middle" x="274.5" y="-460.3" font-family="Open Sans" font-size="14.00">whenever critical vehicle conditions</text>
<text text-anchor="middle" x="274.5" y="-445.3" font-family="Open Sans" font-size="14.00">are detected, ensuring observer awareness.</text>
</g>
<!-- EXP&#45;502&#45;&gt;AST&#45;505 -->
<g id="edge82" class="edge">
<title>EXP&#45;502&#45;&gt;AST&#45;505</title>
<path fill="none" stroke="black" d="M246.78,-437.42C223.91,-410.12 191.35,-371.25 166.83,-341.98"/>
