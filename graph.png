<polygon fill="black" stroke="black" points="4149,-344.16 4145.5,-334.16 4142,-344.16 4149,-344.16"/>
</g>
<!-- EXP&#45;401 -->
<g id="node103" class="node">
<title>EXP&#45;401</title>
<polygon fill="none" stroke="black" points="4612,-513 4349,-513 4349,-430 4612,-430 4612,-513"/>
<text text-anchor="middle" x="4480.5" y="-497.8" font-family="Open Sans" font-size="14.00">EXP&#45;401: The control system shall</text>
<text text-anchor="middle" x="4480.5" y="-482.8" font-family="Open Sans" font-size="14.00">consult VSS metadata (min/max) for</text>
<text text-anchor="middle" x="4480.5" y="-467.8" font-family="Open Sans" font-size="14.00">each actuator signal. Commands that</text>
<text text-anchor="middle" x="4480.5" y="-452.8" font-family="Open Sans" font-size="14.00">exceed these limits must trigger</text>
<text text-anchor="middle" x="4480.5" y="-437.8" font-family="Open Sans" font-size="14.00">an integrity error. H2&#45;400 </text>
</g>
<!-- EXP&#45;401&#45;&gt;AST&#45;401 -->
