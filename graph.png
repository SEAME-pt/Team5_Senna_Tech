<!-- AST&#45;101 -->
<g id="node12" class="node">
<title>AST&#45;101</title>
<polygon fill="none" stroke="black" points="1350,-364 1073,-364 1073,-236 1350,-236 1350,-364"/>
<text text-anchor="middle" x="1211.5" y="-348.8" font-family="Open Sans" font-size="14.00">AST&#45;101: Whenever the STM32 receives</text>
<text text-anchor="middle" x="1211.5" y="-333.8" font-family="Open Sans" font-size="14.00">a CAN message with a &#39;Speed&#39; value</text>
<text text-anchor="middle" x="1211.5" y="-318.8" font-family="Open Sans" font-size="14.00">&gt; 100 or &#39;Steer&#39; &gt; 30 (e.g., &#39;Steer&#39;</text>
<text text-anchor="middle" x="1211.5" y="-303.8" font-family="Open Sans" font-size="14.00">not in [&#45;30, 30]&#39;), respecting the</text>
<text text-anchor="middle" x="1211.5" y="-288.8" font-family="Open Sans" font-size="14.00">physical limits, the message should</text>
<text text-anchor="middle" x="1211.5" y="-273.8" font-family="Open Sans" font-size="14.00">be discarded and the previous state</text>
<text text-anchor="middle" x="1211.5" y="-258.8" font-family="Open Sans" font-size="14.00">of the actuators should be maintained</text>
<text text-anchor="middle" x="1211.5" y="-243.8" font-family="Open Sans" font-size="14.00">unchanged. </text>
</g>
<!-- AST&#45;102 -->
<g id="node13" class="node">
<title>AST&#45;102</title>
<polygon fill="none" stroke="black" points="6213,-341.5 5922,-341.5 5922,-258.5 6213,-258.5 6213,-341.5"/>
<text text-anchor="middle" x="6067.5" y="-326.3" font-family="Open Sans" font-size="14.00">AST&#45;102: If three consecutive CAN</text>
<text text-anchor="middle" x="6067.5" y="-311.3" font-family="Open Sans" font-size="14.00">frames are received with the same</text>
<text text-anchor="middle" x="6067.5" y="-296.3" font-family="Open Sans" font-size="14.00">Rolling Counter value, the can_data_fresh</text>
<text text-anchor="middle" x="6067.5" y="-281.3" font-family="Open Sans" font-size="14.00">flag should be set to false and the</text>
<text text-anchor="middle" x="6067.5" y="-266.3" font-family="Open Sans" font-size="14.00">Safe State should be triggered. </text>
</g>
<!-- EVD&#45;102 -->
<g id="node45" class="node">
