<!-- AST&#45;206 -->
<g id="node20" class="node">
<title>AST&#45;206</title>
<polygon fill="none" stroke="black" points="3246.5,-341.5 2968.5,-341.5 2968.5,-258.5 3246.5,-258.5 3246.5,-341.5"/>
<text text-anchor="middle" x="3107.5" y="-326.3" font-family="Open Sans" font-size="14.00">AST&#45;206: If the capture timer overflows,</text>
<text text-anchor="middle" x="3107.5" y="-311.3" font-family="Open Sans" font-size="14.00">the calculation logic MUST handle</text>
<text text-anchor="middle" x="3107.5" y="-296.3" font-family="Open Sans" font-size="14.00">the event to prevent the speed from</text>
<text text-anchor="middle" x="3107.5" y="-281.3" font-family="Open Sans" font-size="14.00">being calculated as zero or an incorrect</text>
<text text-anchor="middle" x="3107.5" y="-266.3" font-family="Open Sans" font-size="14.00">momentary value. </text>
</g>
