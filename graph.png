<!-- AST&#45;207 -->
<g id="node21" class="node">
<title>AST&#45;207</title>
<polygon fill="none" stroke="black" points="2647.5,-349 2391.5,-349 2391.5,-251 2647.5,-251 2647.5,-349"/>
<text text-anchor="middle" x="2519.5" y="-333.8" font-family="Open Sans" font-size="14.00">AST&#45;207: The system MUST compare</text>
<text text-anchor="middle" x="2519.5" y="-318.8" font-family="Open Sans" font-size="14.00">the calculated wheel speed against</text>
<text text-anchor="middle" x="2519.5" y="-303.8" font-family="Open Sans" font-size="14.00">a secondary estimation source (e.g.,</text>
<text text-anchor="middle" x="2519.5" y="-288.8" font-family="Open Sans" font-size="14.00">IMU) and invalidate the reading if</text>
<text text-anchor="middle" x="2519.5" y="-273.8" font-family="Open Sans" font-size="14.00">the deviation exceeds the defined</text>
<text text-anchor="middle" x="2519.5" y="-258.8" font-family="Open Sans" font-size="14.00">error margin. </text>
</g>
