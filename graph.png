<!-- AST&#45;201 -->
<g id="node17" class="node">
<title>AST&#45;201</title>
<polygon fill="none" stroke="black" points="2055.5,-334 1763.5,-334 1763.5,-266 2055.5,-266 2055.5,-334"/>
<text text-anchor="middle" x="1909.5" y="-318.8" font-family="Open Sans" font-size="14.00">AST&#45;201: If the time counter between</text>
<text text-anchor="middle" x="1909.5" y="-303.8" font-family="Open Sans" font-size="14.00">pulses exceeds the calibrated threshold</text>
<text text-anchor="middle" x="1909.5" y="-288.8" font-family="Open Sans" font-size="14.00">(e.g., 500ms), the system MUST transition</text>
<text text-anchor="middle" x="1909.5" y="-273.8" font-family="Open Sans" font-size="14.00">to the &quot;Signal Lost&quot; error state.</text>
</g>
