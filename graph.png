<!-- AST&#45;103 -->
<g id="node14" class="node">
<title>AST&#45;103</title>
<polygon fill="none" stroke="black" points="1671,-349 1368,-349 1368,-251 1671,-251 1671,-349"/>
<text text-anchor="middle" x="1519.5" y="-333.8" font-family="Open Sans" font-size="14.00">AST&#45;103: If the CRC calculated on</text>
<text text-anchor="middle" x="1519.5" y="-318.8" font-family="Open Sans" font-size="14.00">the 7&#45;byte payload of the CAN message</text>
<text text-anchor="middle" x="1519.5" y="-303.8" font-family="Open Sans" font-size="14.00">does not match the 8th byte (checksum)</text>
<text text-anchor="middle" x="1519.5" y="-288.8" font-family="Open Sans" font-size="14.00">sent by the RPi, the STM32 should</text>
<text text-anchor="middle" x="1519.5" y="-273.8" font-family="Open Sans" font-size="14.00">increment the error counter can_crc_errors</text>
<text text-anchor="middle" x="1519.5" y="-258.8" font-family="Open Sans" font-size="14.00">and ignore the current frame. </text>
</g>
