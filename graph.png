<!-- AST&#45;300 -->
<g id="node22" class="node">
<title>AST&#45;300</title>
<polygon fill="none" stroke="black" points="6840.5,-349 6552.5,-349 6552.5,-251 6840.5,-251 6840.5,-349"/>
<text text-anchor="middle" x="6696.5" y="-333.8" font-family="Open Sans" font-size="14.00">AST&#45;300: The speed sensor task executes</text>
<text text-anchor="middle" x="6696.5" y="-318.8" font-family="Open Sans" font-size="14.00">periodically within its configured</text>
<text text-anchor="middle" x="6696.5" y="-303.8" font-family="Open Sans" font-size="14.00">period and &#160;&#160;completes execution</text>
<text text-anchor="middle" x="6696.5" y="-288.8" font-family="Open Sans" font-size="14.00">before its defined deadline on every</text>
<text text-anchor="middle" x="6696.5" y="-273.8" font-family="Open Sans" font-size="14.00">activation under &#160;&#160;normal operating</text>
<text text-anchor="middle" x="6696.5" y="-258.8" font-family="Open Sans" font-size="14.00">conditions. </text>
</g>
