<!-- AST&#45;704 -->
<g id="node43" class="node">
<title>AST&#45;704</title>
<polygon fill="none" stroke="black" points="10498.5,-326.5 10244.5,-326.5 10244.5,-273.5 10498.5,-273.5 10498.5,-326.5"/>
<text text-anchor="middle" x="10371.5" y="-311.3" font-family="Open Sans" font-size="14.00">AST&#45;704: Every OTA update shall be</text>
