<!-- EXP&#45;205 -->
<g id="node94" class="node">
<title>EXP&#45;205</title>
<polygon fill="none" stroke="black" points="2942.5,-513 2684.5,-513 2684.5,-430 2942.5,-430 2942.5,-513"/>
<text text-anchor="middle" x="2813.5" y="-497.8" font-family="Open Sans" font-size="14.00">EXP&#45;205: The sensor driver interrupt</text>
<text text-anchor="middle" x="2813.5" y="-482.8" font-family="Open Sans" font-size="14.00">and processing logic shall execute</text>
<text text-anchor="middle" x="2813.5" y="-467.8" font-family="Open Sans" font-size="14.00">in an isolated memory region (MPU</text>
<text text-anchor="middle" x="2813.5" y="-452.8" font-family="Open Sans" font-size="14.00">or TrustZone) to prevent external</text>
<text text-anchor="middle" x="2813.5" y="-437.8" font-family="Open Sans" font-size="14.00">interference. </text>
</g>
<!-- EXP&#45;205&#45;&gt;AST&#45;205 -->
<g id="edge69" class="edge">
<title>EXP&#45;205&#45;&gt;AST&#45;205</title>
<path fill="none" stroke="black" d="M2813.02,-429.9C2812.8,-411.05 2812.53,-388.15 2812.28,-366.91"/>
<polygon fill="black" stroke="black" points="2815.77,-366.61 2812.16,-356.65 2808.77,-366.69 2815.77,-366.61"/>
</g>
<!-- EXP&#45;206 -->
<g id="node95" class="node">
<title>EXP&#45;206</title>
<polygon fill="none" stroke="black" points="3252,-498 2963,-498 2963,-445 3252,-445 3252,-498"/>
<text text-anchor="middle" x="3107.5" y="-482.8" font-family="Open Sans" font-size="14.00">EXP&#45;206: The speed calculation algorithm</text>
<text text-anchor="middle" x="3107.5" y="-467.8" font-family="Open Sans" font-size="14.00">shall correctly handle hardware counter</text>
<text text-anchor="middle" x="3107.5" y="-452.8" font-family="Open Sans" font-size="14.00">overflow to maintain speed accuracy.</text>
</g>
<!-- EXP&#45;206&#45;&gt;AST&#45;206 -->
<g id="edge70" class="edge">
<title>EXP&#45;206&#45;&gt;AST&#45;206</title>
