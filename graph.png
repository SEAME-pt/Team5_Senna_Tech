<!-- AST&#45;301 -->
<g id="node23" class="node">
<title>AST&#45;301</title>
<polygon fill="none" stroke="black" points="7135.5,-349 6861.5,-349 6861.5,-251 7135.5,-251 7135.5,-349"/>
<text text-anchor="middle" x="6998.5" y="-333.8" font-family="Open Sans" font-size="14.00">AST&#45;301: Every speed sample produced</text>
<text text-anchor="middle" x="6998.5" y="-318.8" font-family="Open Sans" font-size="14.00">by the system includes a monotonic</text>
<text text-anchor="middle" x="6998.5" y="-303.8" font-family="Open Sans" font-size="14.00">timestamp, and &#160;&#160;samples older than</text>
<text text-anchor="middle" x="6998.5" y="-288.8" font-family="Open Sans" font-size="14.00">the configured freshness threshold</text>
<text text-anchor="middle" x="6998.5" y="-273.8" font-family="Open Sans" font-size="14.00">are automatically &#160;&#160;invalidated and</text>
<text text-anchor="middle" x="6998.5" y="-258.8" font-family="Open Sans" font-size="14.00">not used by downstream control logic.</text>
</g>
